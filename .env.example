# Copia este ficheiro para .env.local e preenche com os dados do teu projeto Supabase
# (Project Settings > API no painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Usadas apenas pela API externa de ensaios (app/api/external/**), nunca expostas ao browser.
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE
REHEARSALS_API_KEY=UMA_CHAVE_SECRETA_PARTILHADA_COM_QUEM_CONSOME_A_API
